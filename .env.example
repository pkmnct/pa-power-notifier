# Copy to .env and fill in. See README.md for every option.

# ── Schedule ─────────────────────────────────────────────────────────────────
# Hours between checks (0 = run once and exit)
CHECK_INTERVAL_HOURS=24
TZ=America/New_York

# ── Electric: PA Power Switch ────────────────────────────────────────────────
# Easiest: paste your papowerswitch.com "shop for rates" results URL, e.g.
# https://www.papowerswitch.com/shop-for-rates-results/?zipcode=…&serviceType=residential&distributor=…&distributorrate=…
ELECTRIC_SHOP_RESULTS_URL=
# …or set the pieces yourself (ELECTRIC_RATE_TYPE is required: no rate type, no offers)
# ELECTRIC_ID=
# ELECTRIC_RATE_TYPE=
# ELECTRIC_ZIPCODE=

# Duquesne Light account (usage, bills, current supplier)
DUQUESNE_USERNAME=
DUQUESNE_PASSWORD=
DUQUESNE_USE_PUPPETEER=1

# ── Gas: PA Gas Switch ───────────────────────────────────────────────────────
# Distributor id from your pagasswitch.com shop URL (distributor=…)
GAS_ID=
GAS_SERVICE_TYPE=residential
# ZIP for the shop page's Price to Compare + price unit (defaults to ELECTRIC_ZIPCODE)
GAS_ZIPCODE=

# Peoples Natural Gas account (usage, bills)
PEOPLES_GAS_USERNAME=
PEOPLES_GAS_PASSWORD=

# ── Duquesne Time-of-Use fallback rates (¢/kWh) ──────────────────────────────
# Used when the tariff PDF can't be scraped; rates change each Jun 1 / Dec 1.
TOU_FLAT_RATE=
TOU_PEAK_RATE=
TOU_OFF_PEAK_RATE=
TOU_SUPER_OFF_PEAK_RATE=

# ── Recommendations ──────────────────────────────────────────────────────────
NOTIFICATION_THRESHOLD=5.0
FILTER_NO_CANCELLATION_FEE=false
FILTER_RENEWABLE_ONLY=false
RATE_JUMP_ALERT_PCT=10
# Suppliers used before your oldest archived bill: "Name@YYYY-MM-DD; Other Name"
PRIOR_ELECTRIC_SUPPLIERS=
PRIOR_GAS_SUPPLIERS=

# ── Email (all of these enable email) ────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_FROM_EMAIL=
NOTIFY_TO_EMAIL=
